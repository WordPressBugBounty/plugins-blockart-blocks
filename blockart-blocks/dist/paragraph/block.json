{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "name": "blockart/paragraph",
  "title": "Paragraph",
  "description": "Customize typography and style paragraphs with multiple setting options.",
  "keywords": [
    "paragraph",
    "text"
  ],
  "category": "blockart",
  "textdomain": "blockart",
  "supports": {
    "className": false,
    "customClassName": false
  },
  "example": {
    "attributes": {}
  },
  "attributes": {
    "clientId": {
      "type": "string"
    },
    "expiryDate": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "alignment": {
      "type": "object",
      "style": [
        {
          "selector": ".blockart-paragraph{{WRAPPER}} {text-align: {{VALUE}}; }"
        }
      ]
    },
    "typography": {
      "type": "object",
      "default": {
        "typography": 1
      },
      "style": [
        {
          "selector": ".blockart-paragraph{{WRAPPER}}"
        }
      ]
    },
    "color": {
      "type": "string",
      "style": [
        {
          "selector": ".blockart-paragraph{{WRAPPER}} {color: {{VALUE}}; }"
        }
      ]
    },
    "hoverColor": {
      "type": "string",
      "style": [
        {
          "selector": ".blockart-paragraph{{WRAPPER}}:hover {color: {{VALUE}}; }"
        }
      ]
    },
    "background": {
      "type": "object",
      "default": {
        "background": 1
      },
      "style": [
        {
          "selector": ".blockart-paragraph{{WRAPPER}}"
        }
      ]
    },
    "hoverBackground": {
      "type": "object",
      "default": {
        "background": 1
      },
      "style": [
        {
          "selector": ".blockart-paragraph{{WRAPPER}}:hover"
        }
      ]
    },
    "enableTooltip": {
      "type": "boolean",
      "default": false
    },
    "tooltipContent": {
      "type": "string",
      "default": "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do."
    },
    "tooltipPosition": {
      "type": "string",
      "default": "right"
    },
    "tooltipTypography": {
      "type": "object",
      "default": {
        "typography": 1
      },
      "style": [
        {
          "selector": ".blockart-paragraph-wrapper{{WRAPPER}} .blockart-tooltip-content"
        }
      ]
    },
    "tooltipColor": {
      "type": "string",
      "style": [
        {
          "selector": ".blockart-paragraph-wrapper{{WRAPPER}} .blockart-tooltip-content {color: {{VALUE}}; }"
        }
      ]
    },
    "tooltipHoverColor": {
      "type": "string",
      "style": [
        {
          "selector": ".blockart-paragraph-wrapper{{WRAPPER}} .blockart-tooltip-content:hover {color: {{VALUE}}; }"
        }
      ]
    },
    "tooltipBackground": {
      "type": "object",
      "default": {
        "background": 1
      },
      "style": [
        {
          "selector": ".blockart-paragraph-wrapper{{WRAPPER}} .blockart-tooltip-content, .blockart-paragraph-wrapper{{WRAPPER}} .blockart-tooltip-content::before"
        }
      ]
    },
    "tooltipHoverBackground": {
      "type": "object",
      "default": {
        "background": 1
      },
      "style": [
        {
          "selector": ".blockart-paragraph-wrapper{{WRAPPER}} .blockart-tooltip-content:hover"
        }
      ]
    },
    "toolTipPadding": {
      "type": "object",
      "default": {
        "dimension": 1,
        "desktop": {
          "lock": true
        }
      },
      "style": [
        {
          "selector": ".blockart-paragraph-wrapper{{WRAPPER}} .blockart-tooltip-content { padding: {{VALUE}}; }"
        }
      ]
    },
    "margin": {
      "type": "object",
      "default": {
        "dimension": 1,
        "desktop": {
          "lock": true
        }
      },
      "style": [
        {
          "selector": ".blockart-paragraph{{WRAPPER}} { margin: {{VALUE}}; }"
        }
      ]
    },
    "blockMargin": {
      "type": "object",
      "default": {
        "dimension": 1,
        "desktop": {
          "lock": true
        }
      },
      "style": [
        {
          "condition": [
            {
              "key": "enableTooltip",
              "relation": "==",
              "value": false
            }
          ],
          "selector": ".blockart-paragraph{{WRAPPER}} { margin: {{VALUE}}; }"
        },
        {
          "condition": [
            {
              "key": "enableTooltip",
              "relation": "==",
              "value": true
            }
          ],
          "selector": ".blockart-paragraph-wrapper{{WRAPPER}} { margin: {{VALUE}}; }"
        }
      ]
    },
    "blockPadding": {
      "type": "object",
      "default": {
        "dimension": 1,
        "desktop": {
          "lock": true
        }
      },
      "style": [
        {
          "condition": [
            {
              "key": "enableTooltip",
              "relation": "==",
              "value": false
            }
          ],
          "selector": ".blockart-paragraph{{WRAPPER}} { padding: {{VALUE}}; }"
        },
        {
          "condition": [
            {
              "key": "enableTooltip",
              "relation": "==",
              "value": true
            }
          ],
          "selector": ".blockart-paragraph-wrapper{{WRAPPER}} { padding: {{VALUE}}; }"
        }
      ]
    },
    "blockZIndex": {
      "type": "number",
      "style": [
        {
          "condition": [
            {
              "key": "enableTooltip",
              "relation": "==",
              "value": false
            }
          ],
          "selector": ".blockart-paragraph{{WRAPPER}} { z-index: {{VALUE}}; }"
        },
        {
          "condition": [
            {
              "key": "enableTooltip",
              "relation": "==",
              "value": true
            }
          ],
          "selector": ".blockart-paragraph-wrapper{{WRAPPER}} { z-index: {{VALUE}}; }"
        }
      ]
    },
    "cssID": {
      "type": "string"
    },
    "animation": {
      "type": "string"
    },
    "interaction": {
      "type": "object"
    },
    "position": {
      "type": "object"
    },
    "hideOnDesktop": {
      "type": "boolean",
      "style": [
        {
          "condition": [
            {
              "key": "enableTooltip",
              "relation": "==",
              "value": false
            }
          ],
          "selector": "@media (min-width:62em) { .blockart-paragraph{{WRAPPER}} { display: none; } }"
        },
        {
          "condition": [
            {
              "key": "enableTooltip",
              "relation": "==",
              "value": true
            }
          ],
          "selector": "@media (min-width:62em) { .blockart-paragraph-wrapper{{WRAPPER}} { display: none; } }"
        }
      ]
    },
    "hideOnTablet": {
      "type": "boolean",
      "style": [
        {
          "condition": [
            {
              "key": "enableTooltip",
              "relation": "==",
              "value": false
            }
          ],
          "selector": "@media (min-width:48em) and (max-width:62em) { .blockart-paragraph{{WRAPPER}} { display: none; } }"
        },
        {
          "condition": [
            {
              "key": "enableTooltip",
              "relation": "==",
              "value": true
            }
          ],
          "selector": "@media (min-width:48em) and (max-width:62em) { .blockart-paragraph-wrapper{{WRAPPER}} { display: none; } }"
        }
      ]
    },
    "hideOnMobile": {
      "type": "boolean",
      "style": [
        {
          "condition": [
            {
              "key": "enableTooltip",
              "relation": "==",
              "value": false
            }
          ],
          "selector": "@media (max-width:48em) { .blockart-paragraph{{WRAPPER}} { display: none; } }"
        },
        {
          "condition": [
            {
              "key": "enableTooltip",
              "relation": "==",
              "value": true
            }
          ],
          "selector": "@media (max-width:48em) { .blockart-paragraph-wrapper{{WRAPPER}} { display: none; } }"
        }
      ]
    },
    "colReverseOnTablet": {
      "type": "boolean",
      "style": [
        {
          "selector": "@media (max-width:62em) { {{WRAPPER}} > .blockart-container > .blockart-section-inner { flex-direction:column-reverse; } }"
        }
      ]
    },
    "colReverseOnMobile": {
      "type": "boolean",
      "style": [
        {
          "selector": "@media (max-width:48em) { {{WRAPPER}} > .blockart-container > .blockart-section-inner { flex-direction:column-reverse; } }"
        }
      ]
    },
    "blockCSS": {
      "type": "string"
    },
    "className": {
      "type": "string"
    }
  },
  "style": "blockart-blocks",
  "editorScript": "blockart-blocks",
  "editorStyle": "blockart-blocks-editor"
}